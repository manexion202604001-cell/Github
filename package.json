{
  "name": "manexion-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "MANEXION monorepo — static sites + AI商品開発OS (apps/web) + 企業SNS企画・市場調査AI (apps/sns)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @manexion/web",
    "build": "npm run build -w @manexion/web",
    "lint": "npm run lint -w @manexion/web",
    "typecheck": "npm run typecheck -w @manexion/web",
    "test": "npm run test -w @manexion/web",
    "dev:sns": "npm run dev -w @manexion/sns",
    "build:sns": "npm run build -w @manexion/sns",
    "lint:sns": "npm run lint -w @manexion/sns",
    "typecheck:sns": "npm run typecheck -w @manexion/sns",
    "test:sns": "npm run test -w @manexion/sns"
  },
  "engines": {
    "node": ">=20.11"
  }
}
