# ── Core ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_product_os?schema=public"
APP_URL="http://localhost:3000"
# openssl rand -base64 32
AUTH_SECRET="change-me-please-32-bytes-minimum-secret"
# 統合設定のシークレット暗号化キー(32byte / base64)
ENCRYPTION_KEY="change-me-please-32-bytes-minimum-secret"

# ── OAuth (要件6) ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Providers ────────────────────────────────────────────────────────
# 未設定なら自動的に mock adapter が選択され、アプリは完全に動作する。
AI_PROVIDER="mock"            # mock | anthropic | openai | google
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_AI_API_KEY=""
AI_MODEL=""

IMAGE_PROVIDER="mock"         # mock | google | openai
IMAGE_MODEL=""

VIDEO_PROVIDER="mock"         # mock | rest
VIDEO_PROVIDER_BASE_URL=""
VIDEO_PROVIDER_API_KEY=""
VIDEO_WEBHOOK_SECRET=""

MARKET_DATA_PROVIDER="mock"   # mock | rakuten | scraper
RAKUTEN_APPLICATION_ID=""
SCRAPER_BASE_URL=""
SCRAPER_USER_AGENT="MANEXION-ProductOS/1.0 (+https://manexion.example/bot)"
SCRAPER_MIN_INTERVAL_MS="2000"
SCRAPER_RESPECT_ROBOTS="true"

STORAGE_PROVIDER="local"      # local | s3 | supabase(Vercel等サーバーレスでは supabase か s3 を推奨)
STORAGE_LOCAL_DIR=".storage"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="product-os"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# ── Jobs ─────────────────────────────────────────────────────────────
# true にすると API から Job を作った直後に同一プロセスで実行する(開発用)。
JOBS_INLINE="true"
JOB_WORKER_TOKEN=""

# ── Mail(認証メール・招待メール)──────────────────────────────────
# resend を指定し RESEND_API_KEY を設定すると実送信。未設定時はログ出力のみ。
MAIL_PROVIDER="console"       # console | resend
RESEND_API_KEY=""
MAIL_FROM="UCCHAU <onboarding@resend.dev>"
