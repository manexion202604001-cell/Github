# ── Core ─────────────────────────────────────────────────────────────
# PostgreSQL(Supabase の接続文字列をそのまま利用できます)。
# 同じデータベースを他アプリと共有する場合は ?schema=sns のように
# 専用スキーマを指定してください(テーブルの衝突を防げます)。
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sns_compass?schema=public"
# スキーマ反映・RLS適用に使う直接接続。未設定なら DATABASE_URL を使用します。
DIRECT_URL=""

APP_URL="http://localhost:3100"

# セッションCookieの署名に使うシークレット。本番では必須です。
# openssl rand -base64 32
AUTH_SECRET="change-me-please-32-bytes-minimum-secret"

# ── Supabase(Auth / Storage を併用する場合)──────────────────────
# 本アプリの認証は自前のセッション方式で動作します。
# Supabase の Storage 等を併用する場合のみ設定してください。
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── AI Provider ──────────────────────────────────────────────────────
# mock | anthropic | openai
# 未設定・キー無しの場合は自動的に mock へフォールバックし、全機能が動作します。
AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# 空欄なら各Providerの既定モデルを使用します。
AI_MODEL=""

# ── Search Provider ──────────────────────────────────────────────────
# mock | tavily | brave | serpapi
SEARCH_PROVIDER="mock"
TAVILY_API_KEY=""
BRAVE_SEARCH_API_KEY=""
SERPAPI_API_KEY=""

# ── Demo Mode ────────────────────────────────────────────────────────
# true にすると、APIキーが設定されていてもサンプルデータで動作します。
DEMO_MODE="false"
